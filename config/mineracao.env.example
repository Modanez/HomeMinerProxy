# Mining farm configuration / Configuração da fazenda de mineração.
# The installer copies this file to /etc/mineracao.env. After editing:
#   sudo systemctl restart mineracao-proxy mineracao-painel mineracao-cubo

# Most of the everyday options (address, language, currency, kWh price, local worker, alarm
# exceptions, cube IP, Telegram) can also be changed on the dashboard: http://SERVER-IP:3000/config
# Values saved there go to DATA_DIR/settings.json and take priority over this file.
# Saving needs this PIN. install.sh creates one; with Docker, set it yourself.
#SETTINGS_PIN=

# Without BTC_ADDRESS the dashboard opens a first-setup wizard in the browser (language, address,
# admin PIN, power price). SETUP_WIZARD=0 makes it refuse to start instead, as in older versions.
#SETUP_WIZARD=1
# The Settings screen checks GitHub for a newer release (once every 6 h). 0 turns that off.
#UPDATE_CHECK=1

# Required: the bitcoin address your miners use as username (address.worker-name).
# Public address only. Never put a seed or private key here.
BTC_ADDRESS=

# Language: en or pt-BR. Empty = dashboard follows the browser (cube and widget use English).
# Add ?lang=en or ?lang=pt to the dashboard URL to override.
LANGUAGE=

# Currency for money values (BTC price, prize, power bill): BRL or USD. Default: BRL for pt-BR, USD otherwise.
#CURRENCY=USD

# Electricity price per kWh, in CURRENCY (used for the power bill estimate).
# Default: 0.90 for BRL, 0.15 for USD. Use a dot for decimals.
#POWER_PRICE_KWH=0.15

# Show the wallet balance and activity on the dashboard (0 hides them; the BTC price still shows
# and Telegram still alerts when money arrives). Default: 1
#SHOW_WALLET=1

# Time zone for quiet hours and the cube clock (needed with Docker; a normal install uses the system's)
#TZ=America/Sao_Paulo

# Dashboard port (with Docker, change the port mapping in compose.yaml instead)
PORT=3000

# Workers that belong to the farm, with nominal hashrate in H/s (JSON in single quotes, one line).
# They show up on the dashboard even before their first share.
#EXPECTED='{"bitaxe":1.2e12,"nerdminer":3.5e5,"laptop":9e6}'
# Bitaxe read from the local AxeOS API (name=IP, comma separated; use the worker name and a fixed IP)
#BITAXES=bitaxe1=192.168.0.140, bitaxe2=192.168.0.141
# Bitaxe alert limits: chip °C, voltage regulator °C, minimum hashrate as % of expected
#BITAXE_TEMP_MAX=68
#BITAXE_VR_MAX=80
#BITAXE_HASH_MIN=70
# Server IP the Bitaxe should point at (only when the server has more than one network)
#BITAXE_SERVER_IP=192.168.0.134
# Temperature unit on the dashboard and Telegram: C or F (alert limits are typed in this unit)
#TEMP_UNIT=C

# Power draw per worker in watts (for the power bill estimate)
#WATTS='{"bitaxe":20,"nerdminer":1,"laptop":35}'
#WATTS_DEFAULT=5

# Worker name of a cpuminer running on this same server (minerd service), if any.
# The dashboard reads its hashrate from the log and shows the CPU temperature next to it.
#LOCAL_WORKER=odroid

# Seconds per screen in kiosk mode (http://localhost:3000/?kiosk)
#ROTATE_S=20

# Siren (Arduino running extras/sirene/sirene.ino on USB)
#ALARM_PORT=/dev/ttyACM0
#QUIET_HOURS=22-8
# Workers that don't turn the red light on when they stop (e.g. a laptop you shut down at night)
#ALARM_IGNORE=laptop

# ckpool-style pools queried by address (comma separated). Default: nerdminers.org and solo.ckpool.org. Empty disables.
#CKPOOL_URLS=https://pool.nerdminers.org/users/YOUR_ADDRESS,https://solo.ckpool.org/users/YOUR_ADDRESS
# OCEAN API (empty disables)
#OCEAN_API=

# Stratum proxy: local port -> pool (JSON in single quotes, one line). Any Stratum V1 pool works.
# Setting this replaces the whole default list below, so keep the routes you still use.
# "backup" lists fallback pools: if the main pool is down, new connections go to the next one.
# Point a route's backups at a pool that pays the same address (solo pools all do).
#PROXY_ROUTES='[{"listen":3333,"host":"public-pool.io","port":21496,"label":"public-pool","backup":[{"host":"solo.ckpool.org","port":3333,"label":"ckpool solo"}]},{"listen":3334,"host":"solo.ckpool.org","port":3333,"label":"ckpool solo","backup":[{"host":"eusolo.ckpool.org","port":3333,"label":"ckpool solo EU"}]},{"listen":3335,"host":"pool.nerdminers.org","port":3333,"label":"nerdminers","backup":[{"host":"public-pool.io","port":21496,"label":"public-pool"}]},{"listen":3337,"host":"mine.ocean.xyz","port":3334,"label":"OCEAN"},{"listen":3338,"host":"solo.atlaspool.io","port":3333,"label":"atlaspool","backup":[{"host":"solo.ckpool.org","port":3333,"label":"ckpool solo"}]},{"listen":3339,"host":"eusolo.ckpool.org","port":3333,"label":"ckpool solo EU","backup":[{"host":"solo.ckpool.org","port":3333,"label":"ckpool solo"}]}]'
# Failover timings, in milliseconds. HEALTH_MS is how often a down pool is retested.
# FAILBACK=1 moves miners back to the main pool as soon as it recovers (0 keeps them on the backup).
#PROXY_CONNECT_TIMEOUT_MS=8000
#PROXY_HEALTH_MS=60000
#PROXY_FAILBACK=1
#PROXY_STATS_PORT=3336

# Telegram bot (optional): alerts for farm records, stopped workers, pool failover, money arriving
# in the wallet, plus a daily summary and the commands /status /workers /luck /records.
# 1. In Telegram, talk to @BotFather, send /newbot and paste the token below. Keep it secret.
# 2. Restart the dashboard and send /start to your bot: it replies with your chat id.
# 3. Put that id in TELEGRAM_CHAT_ID and restart again. Several ids: comma separated.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# Hour of the daily summary (0-23, server time). Empty disables it. Default: 21
#TELEGRAM_DAILY=21
# 1 = also alert personal records of each worker (can be chatty with new miners)
#TELEGRAM_PERSONAL=0
# 1 = every Sunday at the summary hour, send the backup file to the chat (it contains saved keys/passwords). /backup sends it any time
#TELEGRAM_BACKUP=0
# Dashboard link shown in /status (e.g. your Tailscale address)
#TELEGRAM_PANEL_URL=http://odroid:3000

# GeekMagic SmallTV cube (optional). With CUBE_IP set, the installer enables the cube service.
#CUBE_IP=
#CUBE_THEME=3
#CUBE_EVERY_S=300

# Home Assistant / MQTT (optional): publishes Home Assistant Auto-Discovery sensors
# (homeassistant/sensor/homeminerproxy/.../config), farm state every 15s (<prefix>/state)
# and instant events (<prefix>/event: farm_record, personal_record, worker_offline, worker_online,
# pool_failover, pool_recovered, wallet_received, achievement_unlocked).
#MQTT_URL=mqtt://homeassistant.local:1883
#MQTT_USER=
#MQTT_PASS=
#MQTT_TOPIC=homeminerproxy

# Smart Plug — SmartLife / Tuya OpenAPI (optional): reads live Watts/Volts every 30s,
# replaces static power estimates for the linked worker (or monitors a standalone device
# when TUYA_WORKER is empty), exposes /tomada (/plug) on Telegram, and optionally power-cycles
# the plug if the miner goes TUYA_WATCHDOG_MIN minutes without shares.
# Create a free Cloud Project on iot.tuya.com -> Link Tuya App Account (scan with SmartLife).
#TUYA_REGION=us
#TUYA_CLIENT_ID=
#TUYA_SECRET=
#TUYA_DEVICE_ID=
#TUYA_WORKER=
#TUYA_WATCHDOG_MIN=0
# Several plugs, SmartLife/Tuya and Sonoff mixed (JSON in single quotes, one line). Sonoff plugs are
# reached on your network in LAN/DIY mode by IP, no cloud or credentials. Easier on /config.
# The plug of LOCAL_WORKER (this server) can be turned on but never off or rebooted from here.
#TUYA_PLUGS='[{"name":"Bitaxe","deviceId":"eb49d08081c5ba5e80ackt","worker":"bitaxe","watchdogMin":30},{"name":"Vovô","type":"sonoff","host":"192.168.0.50","worker":"devkit"}]'

# Setup Wi-Fi network (needs NetworkManager and a Wi-Fi adapter with AP mode): with no network for
# HOTSPOT_WAIT_S seconds, the board creates the open network HomeMiner-Setup to choose the home Wi-Fi
# from a phone. While it is on, every HOTSPOT_RETRY_MIN minutes with nobody connected it retries the saved Wi-Fi.
#HOTSPOT=0
#HOTSPOT_WAIT_S=90
#HOTSPOT_RETRY_MIN=10
#HOTSPOT_SSID=HomeMiner-Setup
