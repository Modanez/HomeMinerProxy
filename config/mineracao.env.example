# Configuração da fazenda de mineração.
# O instalador copia este arquivo para /etc/mineracao.env. Depois de editar:
#   sudo systemctl restart mineracao-proxy mineracao-painel mineracao-cubo

# Obrigatório: o endereço de bitcoin que os mineradores usam como usuário (endereço.nome-do-worker).
# Só o endereço público. Nunca coloque seed ou chave privada aqui.
BTC_ADDRESS=

# Porta do painel web
PORT=3000

# Workers que fazem parte da fazenda, com o hashrate nominal em H/s (JSON entre aspas simples).
# Aparecem no painel mesmo antes do primeiro share. JSON numa linha só.
#EXPECTED='{"bitaxe":1.2e12,"nerdminer":3.5e5,"macbook":9e6}'

# Consumo de cada worker em watts (para a estimativa da conta de luz) e a tarifa em R$/kWh
#WATTS='{"bitaxe":20,"nerdminer":1,"macbook":35}'
#WATTS_DEFAULT=5
#TARIFA_KWH=0.90

# Nome do worker do cpuminer rodando no próprio servidor (serviço minerd), se houver.
# O painel lê o hashrate dele direto do log e mostra a temperatura ao lado.
#LOCAL_WORKER=odroid

# Tempo de cada tela no modo kiosk (http://localhost:3000/?kiosk), em segundos
#ROTATE_S=20

# Sirene (Arduino com extras/sirene/sirene.ino na USB)
#ALARM_PORT=/dev/ttyACM0
#QUIET_HOURS=22-8
# Workers que não acendem a luz vermelha quando param (ex.: o notebook que você desliga à noite)
#ALARM_IGNORE=macbook

# Pools no formato ckpool consultadas pelo endereço (separadas por vírgula). Padrão: nerdminers.org e solo.ckpool.org. Vazio desliga.
#CKPOOL_URLS=https://pool.nerdminers.org/users/SEU_ENDERECO,https://solo.ckpool.org/users/SEU_ENDERECO
# API da OCEAN (vazio desliga)
#OCEAN_API=

# Proxy Stratum: porta local -> pool. JSON numa linha só.
#PROXY_ROUTES='[{"listen":3333,"host":"public-pool.io","port":21496,"label":"public-pool"},{"listen":3334,"host":"solo.ckpool.org","port":3333,"label":"ckpool solo"},{"listen":3335,"host":"pool.nerdminers.org","port":3333,"label":"nerdminers"},{"listen":3337,"host":"mine.ocean.xyz","port":3334,"label":"OCEAN"}]'
#PROXY_STATS_PORT=3336

# Cubo GeekMagic SmallTV (opcional). Com CUBE_IP preenchido, o instalador ativa o serviço do cubo.
#CUBE_IP=
#CUBE_THEME=3
#CUBE_EVERY_S=300
