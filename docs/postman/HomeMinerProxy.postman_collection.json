{
  "info": {
    "_postman_id": "8c4b11a0-2026-4d00-9a10-000000000001",
    "name": "HomeMinerProxy API (EN)",
    "description": "Complete HTTP collection for **HomeMinerProxy** (`src/painel.js` and `src/proxy.js`).\n\nIncludes:\n- Dashboard HTML pages (`/`, `/?lang=en`, `/?lang=pt`, `/?kiosk`, `/config`)\n- Farm & Widget JSON APIs (`/api/mining`, `/api/widget`, `/api/alarm`)\n- Settings & Integration Test APIs (`/api/config`, `/api/config/test`)\n- Stratum Proxy Internal Stats API (`http://127.0.0.1:3336/stats`)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "proxyStatsUrl", "value": "http://127.0.0.1:3336" },
    { "key": "settingsPin", "value": "123456" },
    { "key": "btcAddress", "value": "bc1qstq0tx86kwgskzxte0l7a6ewtyp0y4z8w4jd2w" },
    { "key": "cubeIp", "value": "192.168.0.50" },
    { "key": "telegramBotToken", "value": "" },
    { "key": "telegramChatId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Dashboard Pages",
      "description": "HTML endpoints served by `src/painel.js` on port 3000.",
      "item": [
        {
          "name": "Dashboard (Default Language)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is text/html', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Serves the 5-screen web dashboard in the default server/browser language."
          }
        },
        {
          "name": "Dashboard (English — ?lang=en)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('HTML lang is en', () => pm.expect(pm.response.text()).to.include('<html lang=\"en\">'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/?lang=en",
              "host": ["{{baseUrl}}"],
              "path": [""],
              "query": [{ "key": "lang", "value": "en" }]
            },
            "description": "Forces English localization on the dashboard."
          }
        },
        {
          "name": "Dashboard (Portuguese — ?lang=pt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('HTML lang is pt-br', () => pm.expect(pm.response.text()).to.include('<html lang=\"pt-br\">'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/?lang=pt",
              "host": ["{{baseUrl}}"],
              "path": [""],
              "query": [{ "key": "lang", "value": "pt" }]
            },
            "description": "Forces Brazilian Portuguese localization on the dashboard."
          }
        },
        {
          "name": "Dashboard (Kiosk Mode — ?kiosk)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/?kiosk",
              "host": ["{{baseUrl}}"],
              "path": [""],
              "query": [{ "key": "kiosk", "value": null }]
            },
            "description": "Opens the dashboard in Kiosk mode (auto-rotates tabs every `ROTATE_S` seconds and hides the mouse cursor)."
          }
        },
        {
          "name": "Settings Screen (/config)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Frame-Options is DENY', () => pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/config",
              "host": ["{{baseUrl}}"],
              "path": ["config"]
            },
            "description": "Serves the web settings screen (`/config`)."
          }
        }
      ]
    },
    {
      "name": "2. Dashboard Data & Hardware APIs",
      "description": "JSON endpoints for farm telemetry, mobile widgets (KWGT), and the Arduino USB siren.",
      "item": [
        {
          "name": "Get Full Mining Snapshot (/api/mining)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Has farm, hall, energy, luck, championship, and achievements', () => {",
                  "  pm.expect(j).to.have.property('farm');",
                  "  pm.expect(j).to.have.property('hall');",
                  "  pm.expect(j).to.have.property('energy');",
                  "  pm.expect(j).to.have.property('luck');",
                  "  pm.expect(j).to.have.property('championship');",
                  "  pm.expect(j).to.have.property('achievements');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mining",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mining"]
            },
            "description": "Returns the complete farm snapshot polled by the web UI, `src/cubo.py`, and `src/ticket.py`."
          }
        },
        {
          "name": "Get Widget Summary — English (/api/widget?lang=en)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Has widget fields', () => {",
                  "  pm.expect(j).to.have.property('recorde');",
                  "  pm.expect(j).to.have.property('hashrate');",
                  "  pm.expect(j).to.have.property('minerando');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/widget?lang=en",
              "host": ["{{baseUrl}}"],
              "path": ["api", "widget"],
              "query": [{ "key": "lang", "value": "en" }]
            },
            "description": "Returns pre-formatted strings in English for Android KWGT or status bar widgets."
          }
        },
        {
          "name": "Get Widget Summary — Portuguese (/api/widget?lang=pt)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/widget?lang=pt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "widget"],
              "query": [{ "key": "lang", "value": "pt" }]
            },
            "description": "Returns pre-formatted strings in Brazilian Portuguese for Android KWGT widgets."
          }
        },
        {
          "name": "Trigger Arduino Siren (/api/alarm?e=T)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Has sent and connected flags', () => {",
                  "  pm.expect(j).to.have.property('sent');",
                  "  pm.expect(j).to.have.property('connected');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alarm?e=T",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alarm"],
              "query": [
                {
                  "key": "e",
                  "value": "T",
                  "description": "Event code: T (test), R (farm record), P (personal record), S (share), 0 (green), 1 (yellow), 2 (red)"
                }
              ]
            },
            "description": "Sends a 1-byte event code to the Arduino USB siren (`ALARM_PORT`). During `QUIET_HOURS`, sound codes (`R`, `P`, `S`, `T`) are sent in lowercase (`r`, `p`, `s`, `t`) for LED-only feedback."
          }
        }
      ]
    },
    {
      "name": "3. Settings & Integration Test APIs",
      "description": "Endpoints handled by `src/settings.js` to read, test, and save runtime configuration (`DATA_DIR/settings.json`).",
      "item": [
        {
          "name": "Get Current Settings (/api/config)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Contains values, workers, and pin flag', () => {",
                  "  pm.expect(j).to.have.property('values');",
                  "  pm.expect(j).to.have.property('workers');",
                  "  pm.expect(j).to.have.property('pin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config"]
            },
            "description": "Returns the current effective configuration values, known worker names, and whether `SETTINGS_PIN` is configured. `TELEGRAM_BOT_TOKEN` is masked (`{ set: boolean, tail: string }`)."
          }
        },
        {
          "name": "Save Settings (/api/config)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"{{settingsPin}}\",\n  \"values\": {\n    \"BTC_ADDRESS\": \"{{btcAddress}}\",\n    \"LANGUAGE\": \"pt-BR\",\n    \"CURRENCY\": \"BRL\",\n    \"POWER_PRICE_KWH\": \"0.90\",\n    \"LOCAL_WORKER\": \"\",\n    \"ALARM_IGNORE\": [],\n    \"WATTS\": {\n      \"bitaxe\": 20,\n      \"nerdminer\": 1\n    },\n    \"EXPECTED\": {\n      \"bitaxe\": \"1.2T\",\n      \"nerdminer\": \"350k\"\n    },\n    \"CUBE_IP\": \"{{cubeIp}}\",\n    \"TELEGRAM_BOT_TOKEN\": \"\",\n    \"TELEGRAM_CHAT_ID\": \"{{telegramChatId}}\",\n    \"TELEGRAM_DAILY\": \"21\",\n    \"TELEGRAM_PERSONAL\": false,\n    \"TELEGRAM_PANEL_URL\": \"\",\n    \"MQTT_URL\": \"mqtt://homeassistant.local:1883\",\n    \"MQTT_USER\": \"\",\n    \"MQTT_PASS\": \"\",\n    \"MQTT_TOPIC\": \"homeminerproxy\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config"]
            },
            "description": "Validates and writes modified settings to `DATA_DIR/settings.json`. Requires a valid `SETTINGS_PIN`. If any value changed, returns `{ ok: true, restart: true }` and restarts the dashboard process."
          }
        },
        {
          "name": "Export Backup (/api/config/backup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Returns ok and backup v1 object', () => {",
                  "  pm.expect(j.ok).to.eql(true);",
                  "  pm.expect(j.backup.version).to.eql(1);",
                  "  pm.expect(j.backup).to.have.property('data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"{{settingsPin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/config/backup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config", "backup"]
            },
            "description": "Exports a single-file JSON backup (`version: 1`) containing `settings`, `workers`, `records`, `history`, `proxyStats`, `telegram`, and `cubo`. Requires `SETTINGS_PIN`."
          }
        },
        {
          "name": "Restore Backup (/api/config/restore)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"{{settingsPin}}\",\n  \"backup\": {\n    \"app\": \"home-miner-proxy\",\n    \"version\": 1,\n    \"data\": {\n      \"settings\": {\n        \"CURRENCY\": \"BRL\",\n        \"WATTS\": \"{\\\"bitaxe\\\":20}\"\n      },\n      \"records\": [\n        {\n          \"worker\": \"bitaxe\",\n          \"value\": 4096,\n          \"at\": \"2026-11-03T12:00:00.000Z\"\n        }\n      ]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/config/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config", "restore"]
            },
            "description": "Validates and restores a backup payload to `DATA_DIR`, then restarts the dashboard service. Requires `SETTINGS_PIN`."
          }
        },
        {
          "name": "Test GeekMagic Cube (/api/config/test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"{{settingsPin}}\",\n  \"what\": \"cube\",\n  \"values\": {\n    \"CUBE_IP\": \"{{cubeIp}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/config/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config", "test"]
            },
            "description": "Tests whether the GeekMagic SmallTV cube responds over HTTP at `CUBE_IP`."
          }
        },
        {
          "name": "Test Telegram Bot (/api/config/test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"{{settingsPin}}\",\n  \"what\": \"telegram\",\n  \"values\": {\n    \"TELEGRAM_BOT_TOKEN\": \"{{telegramBotToken}}\",\n    \"TELEGRAM_CHAT_ID\": \"{{telegramChatId}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/config/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config", "test"]
            },
            "description": "Sends a test message to `TELEGRAM_CHAT_ID` using `TELEGRAM_BOT_TOKEN` (or the token already configured on the server if left empty)."
          }
        },
        {
          "name": "Test MQTT Broker (/api/config/test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"{{settingsPin}}\",\n  \"what\": \"mqtt\",\n  \"values\": {\n    \"MQTT_URL\": \"mqtt://homeassistant.local:1883\",\n    \"MQTT_USER\": \"\",\n    \"MQTT_PASS\": \"\",\n    \"MQTT_TOPIC\": \"homeminerproxy\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/config/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "config", "test"]
            },
            "description": "Tests connectivity and authentication with the MQTT 3.1.1 broker at `MQTT_URL` (`CONNECT` -> `CONNACK` -> `PUBLISH <topic>/availability` -> `DISCONNECT`)."
          }
        }
      ]
    },
    {
      "name": "4. Stratum Proxy Internal API",
      "description": "Local-only HTTP endpoint served by `src/proxy.js` on `127.0.0.1:3336`.",
      "item": [
        {
          "name": "Get Raw Proxy Stats (/stats)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Contains routes, workers, recent, totals, hist, and week', () => {",
                  "  pm.expect(j).to.have.property('routes');",
                  "  pm.expect(j).to.have.property('workers');",
                  "  pm.expect(j).to.have.property('recent');",
                  "  pm.expect(j).to.have.property('totals');",
                  "  pm.expect(j).to.have.property('hist');",
                  "  pm.expect(j).to.have.property('week');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{proxyStatsUrl}}/stats",
              "host": ["{{proxyStatsUrl}}"],
              "path": ["stats"]
            },
            "description": "Returns real-time Stratum V1 proxy telemetry: upstream routes & failover status, connected workers, 1h share window hashrate, recent 100 shares, `bestHash`, `dayBestHash`, and the 40-bucket difficulty histogram (`hist`)."
          }
        }
      ]
    }
  ]
}

